diff --git a/bin/rexweb-pane b/bin/rexweb-pane
index 7f317b8..583db3b 100755
--- a/bin/rexweb-pane
+++ b/bin/rexweb-pane
@@ -4,6 +4,12 @@
 # the panel if RexWeb restarts, and closes the panel when the pane goes away.
 set -u
 PATH="$PATH:/usr/bin:/opt/homebrew/bin:/usr/local/bin"
+# Local addition: with a program at ~/.rexweb/pane (or $REXWEB_INLINE), that
+# program holds the pane and draws the page inside the terminal itself, so
+# no window is floated over Rex. See rexpaper/mac/webpane.py in
+# remarkable-harness.
+inline="${REXWEB_INLINE:-$HOME/.rexweb/pane}"
+[ -x "$inline" ] && exec "$inline" "$@"
 url="${1:-}"
 cfg="$HOME/.rexweb/config.json"
 port="${REXWEB_PORT:-$(jq -r '.port // 18802' "$cfg" 2>/dev/null || echo 18802)}"
